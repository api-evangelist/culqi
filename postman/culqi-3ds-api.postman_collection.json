            },
            "url": {
              "raw": "{{baseUrl}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "confirm"
              ]
            },
            "description": "Confirms a charge whose token was authenticated via Culqi 3DS. Sent to the secure host with the public key after the cardholder completes the 3-D Secure challenge."

          "name": "Confirm a 3DS-authenticated charge",
          "id": "8d9155af-c39d-43e5-8d04-cdb8f56537a1",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",

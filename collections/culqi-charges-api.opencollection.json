{
  "opencollection": "1.0.0",
  "info": {
    "name": "Culqi API v2 3DS Charges API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Charges",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List charges",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.culqi.com/v2/charges",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of records to return (max 100)."
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Cursor - return records created before this id."
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor - return records created after this id."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List charges"
        },
        {
          "info": {
            "name": "Create a charge",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.culqi.com/v2/charges",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a one-time charge (cargo) against a token, saved card or Yape token. amount is an integer in the currency minor unit (cents), currency_code is PEN or USD."
        },
        {
          "info": {
            "name": "Retrieve a charge",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.culqi.com/v2/charges/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique resource identifier."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a charge"
        },
        {
          "info": {
            "name": "Update charge metadata",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.culqi.com/v2/charges/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique resource identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update charge metadata"
        },
        {
          "info": {
            "name": "Capture a pre-authorized charge",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.culqi.com/v2/charges/:id/capture",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique resource identifier."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Captures a charge that was created with capture=false (authorization hold)."
        }
      ]
    }
  ],
  "bundled": true
}
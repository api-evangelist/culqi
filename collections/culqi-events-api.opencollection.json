{
  "opencollection": "1.0.0",
  "info": {
    "name": "Culqi API v2 3DS Events API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List webhook events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.culqi.com/v2/events",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of records to return (max 100)."
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Cursor - return records created before this id."
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor - return records created after this id."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists account events (charge.creation.succeeded, order.status.changed, etc.) delivered to webhooks."
        },
        {
          "info": {
            "name": "Retrieve an event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.culqi.com/v2/events/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique resource identifier."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve an event"
        }
      ]
    }
  ],
  "bundled": true
}